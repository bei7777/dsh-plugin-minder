{
  "name": "dsh-plugin-minder-snapshot",
  "version": "0.2.0",
  "description": "Stage local file changes in a task, review the diff and undo the transaction.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bei7777/dsh-plugin-minder.git",
    "directory": "packages/snapshot"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "import": "./lib/index.js" } },
  "files": ["lib/", "cordis.patch.yml", "LICENSE"],
  "keywords": ["dsh-plugin", "deepseek-harness", "minder", "snapshot"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "hub": {
      "schemaVersion": 1,
      "displayName": "Minder Snapshot",
      "summary": "Review and undo task-scoped edits to local files, including files outside Git repositories.",
      "entryIds": ["minder-snapshot"],
      "compatibility": { "dsh": "0.2.2-rc.5", "node": ">=24.9.0" }
    }
  },
  "engines": { "node": ">=24.9.0", "dsh": "0.2.2-rc.5" },
  "publishConfig": { "access": "public" },
  "scripts": { "build": "tsc -p tsconfig.json", "prepack": "pnpm run build" },
  "dependencies": { "@minder/core-snapshot": "0.2.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-user-questions": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-user-questions": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5"
  }
}
